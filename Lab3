import json
import pandas as pd


def run_pipeline(csv_file_path: str, json_file_path: str):
  # 1. Extract
  df = pd.read_csv(csv_file_path)

  # 2. Transform: Group by Department and compute total salary spend
  departments_data = {}

  for department, group in df.groupby("Department"):
    total_spend = float(group["Salary"].sum())
    employees = []

    for _, row in group.iterrows():
      employees.append({
          "id": int(row["EmpID"]),
          "name": str(row["Name"]),
          "salary": float(row["Salary"]),
      })

    departments_data[str(department)] = {
        "total_spend": total_spend,
        "employees": employees,
    }

  pipeline_output = {"departments": departments_data}

  # 3. Load
  with open(json_file_path, "w", encoding="utf-8") as f:
    json.dump(pipeline_output, f, indent=4)

  print(f"Pipeline executed successfully. Output saved to {json_file_path}")


# Run pipeline on employees CSV
run_pipeline("employees.csv", "departments_output.json")
